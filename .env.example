# Neon Postgres connection string. Without it, the waitlist route falls
# back to appending signups to data/waitlist.jsonl for local development.
DATABASE_URL=

# Resend API key for confirmation emails. Without it, the confirmation
# email is skipped (logged, not sent).
RESEND_API_KEY=

# Sender address for confirmation emails. Defaults to "Mutuals <hello@getmutuals.ai>".
EMAIL_FROM=

# Cloudflare Turnstile secret key, used server-side to verify submissions.
# Without it, Turnstile verification is skipped entirely.
TURNSTILE_SECRET_KEY=

# Cloudflare Turnstile site key, used client-side to render the widget.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Plausible Analytics domain for the cookieless analytics script.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
